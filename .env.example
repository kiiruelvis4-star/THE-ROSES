# =============================================================================
# LITTLE ROSES ACADEMY - ENVIRONMENT CONFIGURATION
# =============================================================================

# GEMINI_API_KEY: Optional - for Gemini AI CBC rationalization assistants
# Configure in the Settings / Secrets panel in Google AI Studio
GEMINI_API_KEY=
APP_URL=

# -----------------------------------------------------------------------------
# SUPABASE BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
# Provide your own Supabase project credentials below.
# Where to find them in your Supabase Dashboard:
# 1. Sign in to https://supabase.com/dashboard
# 2. Select your project (or click "New project")
# 3. Go to Project Settings (gear icon in sidebar) -> API
#
# VITE_SUPABASE_URL:
#   The Project URL (e.g. https://xyzcompanyproject.supabase.co)
#
# VITE_SUPABASE_ANON_KEY:
#   The 'anon' / 'public' API key (safe for browser client).
#   CRITICAL: Do NOT use your 'service_role' secret key!
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
